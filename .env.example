# Hound v3.0 - Environment Configuration
# Copy this to .env and fill in your values

# Database Configuration
DATABASE_URL=sqlite:///./hound.db
# For production: DATABASE_URL=postgresql://user:password@localhost/hound_db

# API Configuration
API_KEY=your-secret-api-key-here
WEBHOOK_SECRET=your-webhook-secret-here
DEBUG=True
LOG_LEVEL=INFO

# Server Configuration
HOST=0.0.0.0
PORT=8000
VIEWER_PORT=8082

# File Paths
DATA_DIR=./data
LOG_DIR=./logs
